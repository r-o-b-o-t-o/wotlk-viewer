# Copy to .env and point at your own install. All data is local; nothing is fetched online.

# Extracted 3.3.5a client: the base archives' contents at its root and a <locale>/ directory for
# the locale ones, which is how the client addresses them from inside Data. Produce it with
# `npm run extract -w packages/server`, which unpacks the MPQs in the order the client reads them.
WOW_CLIENT_DIR=/path/to/extracted-client

# AzerothCore characters database. Leave empty to run without the character API. The world database
# is looked up alongside it (same server, `_characters` suffix swapped for `_world`) for the creature
# family that sizes a pet; nothing breaks when it is not there.
WOW_DB_URL=mysql://user:password@localhost:3306/acore_characters

# Port for the standalone server in packages/server.
PORT=8090

# Not read by any code, recorded so a session does not have to hunt for them:
# the AzerothCore sources that document the database schema, and the mysql client.
AZEROTHCORE_SRC=/path/to/azerothcore
MYSQL_CLI=mysql
