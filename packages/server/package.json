{
  "name": "@wotlk-viewer/server",
  "version": "0.1.0",
  "description": "Dev server serving extracted WoW client files and AzerothCore character data",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "wotlk-viewer-server": "./bin/cli.js"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
