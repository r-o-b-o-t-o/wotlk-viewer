{
	"name": "@wotlk-viewer/server",
	"version": "0.1.0",
	"description": "Dev server serving extracted WoW client files and AzerothCore character data",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./fs": "./src/FsDataSource.ts"
	},
	"scripts": {
		"start": "tsx --env-file-if-exists=../../.env src/cli.ts",
		"extract": "tsx --env-file-if-exists=../../.env src/extractCli.ts",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@wotlk-viewer/core": "*",
		"argparse": "^3.0.4",
		"cli-progress": "^3.12.0",
		"mysql2": "^3.14.0"
	},
	"devDependencies": {
		"@types/cli-progress": "^3.11.6",
		"tsx": "^4.20.0"
	}
}
