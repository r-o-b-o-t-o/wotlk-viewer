# Copy to .env and point at your own install. All data is local; nothing is fetched online.

# Extracted 3.3.5a client: any folder you unpacked the MPQ archives into, holding a Data/
# directory and one Data_<locale>/ per locale. The folder names are yours to choose.
WOW_CLIENT_DIR=/path/to/extracted-client

# AzerothCore characters database. Leave empty to run without the character API.
WOW_DB_URL=mysql://user:password@localhost:3306/acore_characters

# Port for the standalone server in packages/server.
PORT=8090

# Not read by any code, recorded so a session does not have to hunt for them:
# the AzerothCore sources that document the database schema, and the mysql client.
AZEROTHCORE_SRC=/path/to/azerothcore
MYSQL_CLI=mysql
